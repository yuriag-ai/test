# Supabase Configuration
# Copie este arquivo para .env.local e preencha com suas credenciais

# Project URL - Encontre em: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Anon/Public Key - Encontre em: Supabase Dashboard → Settings → API → Project API keys
VITE_SUPABASE_ANON_KEY=sua-chave-anon-aqui

# ⚠️ IMPORTANTE:
# 1. Nunca commite o arquivo .env.local (apenas .env.example)
# 2. Use apenas a chave ANON (não a service_role) no frontend
# 3. Consulte SUPABASE_SETUP.md para instruções completas
