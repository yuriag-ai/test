# Chave da API da Anthropic (Claude) — usada SOMENTE no servidor (pasta api/ e no `npm run dev`).
# Nunca use o prefixo VITE_ aqui: isso exporia a chave no navegador.
ANTHROPIC_API_KEY=

# Opcional: modelo usado para gerar Ata e Plano de Ação (padrão: claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5
